<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <RootNamespace>CVPN</RootNamespace>
        <AssemblyName>CVPN</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\cvpn.ico</ApplicationIcon>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="QRCoder" Version="1.8.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CVPN.Service\CVPN.Service.csproj"
                          ReferenceOutputAssembly="false"
                          Private="false" />
    </ItemGroup>

    <Target Name="CopyServiceOutput" AfterTargets="Build">
        <ItemGroup>
            <ServiceFiles Include="..\CVPN.Service\bin\$(Configuration)\$(TargetFramework)\**\*"
                          Exclude="..\CVPN.Service\bin\$(Configuration)\$(TargetFramework)\**\*.pdb" />
        </ItemGroup>

        <Copy SourceFiles="@(ServiceFiles)"
              DestinationFolder="$(OutDir)service\%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition="'@(ServiceFiles)' != ''" />

        <Message Importance="normal"
                 Text="Служба скопирована в $(OutDir)service (файлов: @(ServiceFiles->Count()))" />
    </Target>

    <ItemGroup>
        <Using Remove="System.Windows.Forms" />
        <Using Remove="System.Drawing" />
    </ItemGroup>


    <ItemGroup>
        <Resource Include="Assets\cvpn.ico" />
        <Resource Include="Assets\cvpn-connected.ico" />
        <Resource Include="Assets\cvpn-idle.ico" />
        <Resource Include="Assets\Flags\*.png" />
    </ItemGroup>

</Project>
