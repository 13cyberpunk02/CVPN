<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <RootNamespace>CVPN</RootNamespace>
        <AssemblyName>CVPN</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\cvpn.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="QRCoder" Version="1.8.0" />
      <PackageReference Include="SolimusWrapper" Version="1.0.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- UseWindowsForms добавляет эти пространства имён в глобальные using на весь
             проект, из-за чего UserControl, Application и подобные типы становятся
             неоднозначными с WPF. WinForms нужен ровно в одном файле — TrayIcon.cs,
             где он подключается явно. -->
        <Using Remove="System.Windows.Forms" />
        <Using Remove="System.Drawing" />
    </ItemGroup>


    <ItemGroup>
        <Resource Include="Assets\cvpn.ico" />
        <Resource Include="Assets\cvpn-connected.ico" />
        <Resource Include="Assets\cvpn-idle.ico" />
        <Resource Include="Assets\Flags\*.png" />
    </ItemGroup>

</Project>
