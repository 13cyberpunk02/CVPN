<UserControl x:Class="CVPN.Views.RoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CVPN.Models"
             xmlns:enums="clr-namespace:CVPN.Models.Enums"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CVPN.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RoutingViewModel, IsDesignTimeCreatable=False}">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Маршруты" Style="{StaticResource T.Title}" 
                           Margin="0,0,0,7"/>
                <TextBlock Text="Правила проверяются сверху вниз. Первое совпадение решает судьбу соединения."
                           Style="{StaticResource T.Secondary}" 
                           Margin="0,7,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox Style="{StaticResource Select}" Width="180"
                          ItemsSource="{Binding RoutingProfiles}"
                          SelectedItem="{Binding ActiveRouting}"
                          DisplayMemberPath="Name" />
                <Button Content="Новый" Style="{StaticResource Btn.Base}" Margin="8,0,0,0"
                        Command="{Binding AddSet}" />
                <Button Content="Удалить" Style="{StaticResource Btn.Ghost}" Margin="6,0,0,0"
                        Command="{Binding RemoveSet}" />
            </StackPanel>
        </Grid>

        <!-- Конструктор правила -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="164" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="164" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="MatchBox" Grid.Column="0" Style="{StaticResource Select}" SelectedIndex="0"
                          SelectionChanged="OnMatchChanged">
                    <ComboBoxItem Content="geosite" />
                    <ComboBoxItem Content="geoip" />
                    <ComboBoxItem Content="domain" />
                    <ComboBoxItem Content="domain_suffix" />
                    <ComboBoxItem Content="domain_keyword" />
                    <ComboBoxItem Content="process_name" />
                    <ComboBoxItem Content="rule_set · ссылка" />
                    <ComboBoxItem Content="rule_set · файл" />
                </ComboBox>

                <TextBox x:Name="ValueBox" Grid.Column="1" Style="{StaticResource Input}" Margin="8,0"
                         Tag="youtube · twitch · category-ads-all" />
                <Button x:Name="PickSrsButton" Grid.Column="2" Content="Выбрать .srs"
                        Style="{StaticResource Btn.Base}" Margin="0,0,8,0" Click="OnPickSrs" />

                <ComboBox x:Name="ActionBox" Grid.Column="3" Style="{StaticResource Select}" SelectedIndex="0">
                    <ComboBoxItem Content="через прокси" />
                    <ComboBoxItem Content="напрямую" />
                    <ComboBoxItem Content="блокировать" />
                </ComboBox>

                <Button Grid.Column="4" Content="Добавить" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0"
                        Click="OnAddRule" />
            </Grid>
        </Border>

        <ListBox Grid.Row="2" Style="{StaticResource PlainList}" Margin="0,14,0,0" ItemsSource="{Binding Rules}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:RouteRule}">
                    <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource Radius}"
                            Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" Style="{StaticResource Switch}"
                                          IsChecked="{Binding Enabled}" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" Text="{Binding MatchLabel}" Style="{StaticResource T.Mono}"
                                       FontSize="{StaticResource Size.Small}" Margin="14,0,0,0"
                                       Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" ToolTip="{Binding Value}"
                                       Style="{StaticResource T.Mono}"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center" />

                            <Border Grid.Column="3" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Tint.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Action}"
                                                         Value="{x:Static enums:RouteAction.Direct}">
                                                <Setter Property="Background" Value="{StaticResource Tint.Connected}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Action}"
                                                         Value="{x:Static enums:RouteAction.Block}">
                                                <Setter Property="Background" Value="{StaticResource Tint.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ActionLabel}" FontSize="{StaticResource Size.Caption}"
                                           FontFamily="{StaticResource Font.Sans}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Action}"
                                                             Value="{x:Static enums:RouteAction.Direct}">
                                                    <Setter Property="Foreground" Value="{StaticResource Connected}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}"
                                                             Value="{x:Static enums:RouteAction.Block}">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                                <!-- Порядок решает: первое совпадение выигрывает -->
                                <Button Content="▲" Style="{StaticResource Btn.Ghost}" Padding="8,4"
                                        ToolTip="Выше по списку - правило сработает раньше"
                                        Command="{Binding DataContext.MoveUp,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="▼" Style="{StaticResource Btn.Ghost}" Padding="8,4"
                                        ToolTip="Ниже по списку"
                                        Command="{Binding DataContext.MoveDown,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="✕" Style="{StaticResource Btn.Ghost}" Padding="10,4"
                                        Margin="4,0,0,0"
                                        Command="{Binding DataContext.RemoveRule,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,12" Margin="0,4,0,0" BorderThickness="0">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Всё остальное" Style="{StaticResource T.Body}" />
                    <TextBlock Text="Что делать с трафиком, не попавшим ни в одно правило"
                               Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <ComboBox x:Name="FinalBox" Style="{StaticResource Select}" Width="164"
                          HorizontalAlignment="Right" SelectionChanged="OnFinalChanged">
                    <ComboBoxItem Content="через прокси" />
                    <ComboBoxItem Content="напрямую" />
                </ComboBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>