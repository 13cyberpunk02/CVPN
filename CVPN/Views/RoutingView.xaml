<UserControl x:Class="CVPN.Views.RoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CVPN.Localization"
             xmlns:models="clr-namespace:CVPN.Models"
             xmlns:enums="clr-namespace:CVPN.Models.Enums"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CVPN.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RoutingViewModel, IsDesignTimeCreatable=False}">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="{loc:T Nav_Routing}" Style="{StaticResource T.Title}" />
                <TextBlock Text="{loc:T Routing_Subtitle}"
                           Style="{StaticResource T.Secondary}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox Style="{StaticResource Select}" Width="180"
                          ItemsSource="{Binding RoutingProfiles}"
                          SelectedItem="{Binding ActiveRouting}"
                          DisplayMemberPath="Name" />
                <Button Content="{loc:T Common_New}" Style="{StaticResource Btn.Base}" Margin="8,0,0,0"
                        Command="{Binding AddSet}" />
                <Button Content="{loc:T Common_Delete}" Style="{StaticResource Btn.Ghost}" Margin="6,0,0,0"
                        Command="{Binding RemoveSet}" />
            </StackPanel>
        </Grid>

        <!-- Конструктор правила -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="164" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="164" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="MatchBox" Grid.Column="0" Style="{StaticResource Select}" SelectedIndex="0"
                          SelectionChanged="OnMatchChanged">
                    <ComboBoxItem Content="geosite" />
                    <ComboBoxItem Content="geoip" />
                    <ComboBoxItem Content="domain" />
                    <ComboBoxItem Content="domain_suffix" />
                    <ComboBoxItem Content="domain_keyword" />
                    <ComboBoxItem Content="process_name" />
                    <ComboBoxItem Content="{loc:T Routing_SetRemote}" />
                    <ComboBoxItem Content="{loc:T Routing_SetLocal}" />
                </ComboBox>

                <TextBox x:Name="ValueBox" Grid.Column="1" Style="{StaticResource Input}" Margin="8,0"
                         Tag="youtube · twitch · category-ads-all" />
                <Button x:Name="PickSrsButton" Grid.Column="2" Content="{loc:T Routing_PickSrs}"
                        Style="{StaticResource Btn.Base}" Margin="0,0,8,0" Click="OnPickSrs" />

                <ComboBox x:Name="ActionBox" Grid.Column="3" Style="{StaticResource Select}" SelectedIndex="0">
                    <ComboBoxItem Content="{loc:T Common_ViaProxy}" />
                    <ComboBoxItem Content="{loc:T Common_Direct}" />
                    <ComboBoxItem Content="{loc:T Common_Block}" />
                </ComboBox>

                <Button Grid.Column="4" Content="{loc:T Common_Add}" Style="{StaticResource Btn.Primary}"
                        Margin="8,0,0,0"
                        Click="OnAddRule" />
            </Grid>
        </Border>

        <!-- Проверка домена: отвечает на вопрос «какое правило сработает»
             без подключения и без чтения логов -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource Input}"
                             Text="{Binding TestInput, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{loc:T Routing_TestHint}" />
                    <Button Grid.Column="1" Content="{loc:T Common_Check}" Style="{StaticResource Btn.Base}"
                            Margin="8,0,0,0" Command="{Binding TestDomain}" />
                </Grid>

                <TextBlock Text="{Binding TestResult}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource T.Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTestResult}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestOutcome}"
                                             Value="{x:Static enums:RouteAction.Direct}">
                                    <Setter Property="Foreground" Value="{StaticResource Connected}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestOutcome}"
                                             Value="{x:Static enums:RouteAction.Block}">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestOutcome}"
                                             Value="{x:Static enums:RouteAction.Proxy}">
                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <ListBox Grid.Row="3" Style="{StaticResource PlainList}" Margin="0,14,0,0" ItemsSource="{Binding Rules}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:RouteRule}">
                    <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource Radius}"
                            Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" Style="{StaticResource Switch}"
                                          IsChecked="{Binding Enabled}" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" Text="{Binding MatchLabel}" Style="{StaticResource T.Mono}"
                                       FontSize="{StaticResource Size.Small}" Margin="14,0,0,0"
                                       Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" ToolTip="{Binding Value}"
                                       Style="{StaticResource T.Mono}"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center" />

                            <Border Grid.Column="3" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Tint.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Action}"
                                                         Value="{x:Static enums:RouteAction.Direct}">
                                                <Setter Property="Background" Value="{StaticResource Tint.Connected}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Action}"
                                                         Value="{x:Static enums:RouteAction.Block}">
                                                <Setter Property="Background" Value="{StaticResource Tint.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ActionLabel}" FontSize="{StaticResource Size.Caption}"
                                           FontFamily="{StaticResource Font.Sans}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Action}"
                                                             Value="{x:Static enums:RouteAction.Direct}">
                                                    <Setter Property="Foreground" Value="{StaticResource Connected}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}"
                                                             Value="{x:Static enums:RouteAction.Block}">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                                <!-- Порядок решает: первое совпадение выигрывает -->
                                <Button Content="▲" Style="{StaticResource Btn.Ghost}" Padding="8,4"
                                        ToolTip="{loc:T Routing_MoveUpHint}"
                                        Command="{Binding DataContext.MoveUp,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="▼" Style="{StaticResource Btn.Ghost}" Padding="8,4"
                                        ToolTip="{loc:T Routing_MoveDownHint}"
                                        Command="{Binding DataContext.MoveDown,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="✕" Style="{StaticResource Btn.Ghost}" Padding="10,4"
                                        Margin="4,0,0,0"
                                        Command="{Binding DataContext.RemoveRule,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,12" Margin="0,4,0,0" BorderThickness="0">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{loc:T Routing_Fallback}" Style="{StaticResource T.Body}" />
                    <TextBlock Text="{loc:T Routing_FallbackHint}"
                               Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <ComboBox x:Name="FinalBox" Style="{StaticResource Select}" Width="164"
                          HorizontalAlignment="Right" SelectionChanged="OnFinalChanged">
                    <ComboBoxItem Content="{loc:T Common_ViaProxy}" />
                    <ComboBoxItem Content="{loc:T Common_Direct}" />
                </ComboBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>