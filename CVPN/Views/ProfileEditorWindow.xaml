<Window x:Class="CVPN.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CVPN.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:CVPN.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=models:ServerProfile, IsDesignTimeCreatable=False}"
        Title="Профиль" Width="520" SizeToContent="Height" MinHeight="420"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="24,20">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="{loc:T Editor_New}" Style="{StaticResource T.Title}" />
            <TextBlock Text="{loc:T Editor_Subtitle}" Style="{StaticResource T.Secondary}"
                       Margin="0,4,0,0" />

            <!-- ===== общее ===== -->
            <TextBlock Text="{loc:T Editor_Name}" Style="{StaticResource T.Label}" Margin="0,20,0,7" />
            <TextBox Style="{StaticResource Input}" Tag="Amsterdam"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{loc:T Editor_Protocol}" Style="{StaticResource T.Label}" Margin="0,14,0,7" />
            <ComboBox x:Name="ProtocolBox" Style="{StaticResource Select}"
                      SelectionChanged="OnProtocolChanged">
                <ComboBoxItem Content="VLESS · Reality" />
                <ComboBoxItem Content="VLESS · WebSocket + TLS" />
                <ComboBoxItem Content="AnyTLS" />
                <ComboBoxItem Content="NaiveProxy" />
            </ComboBox>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{loc:T Editor_Host}" Style="{StaticResource T.Label}" Margin="0,0,0,7" />
                    <TextBox Style="{StaticResource Input}" Tag="nl-01.example.net"
                             Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="{loc:T Editor_Port}" Style="{StaticResource T.Label}" Margin="0,0,0,7" />
                    <TextBox Style="{StaticResource Input}" Tag="443"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:T Editor_Country}" Style="{StaticResource T.Label}" Margin="0,0,0,7" />
                    <TextBox Style="{StaticResource Input}" Tag="NL" MaxLength="2"
                             Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{loc:T Editor_Sni}" Style="{StaticResource T.Label}" Margin="0,14,0,7" />
            <TextBox Style="{StaticResource Input}" Tag="www.google.com"
                     Text="{Binding Sni, UpdateSourceTrigger=PropertyChanged}" />

            <!-- ===== VLESS ===== -->
            <StackPanel x:Name="VlessGroup">
                <TextBlock Text="uuid" Style="{StaticResource T.Label}" Margin="0,14,0,7" />
                <TextBox Style="{StaticResource Input}" Tag="8f1ce66e-719d-48b8-9ee6-804b52887082"
                         Text="{Binding Uuid, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- ===== Reality ===== -->
            <StackPanel x:Name="RealityGroup">
                <TextBlock Text="public key · pbk" Style="{StaticResource T.Label}" Margin="0,14,0,7" />
                <TextBox Style="{StaticResource Input}" Tag="A32t3s5q0ea82zSZKJOtT-HrXKwkwa9r9pjgnRveVT8"
                         Text="{Binding PublicKey, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="short id · sid" Style="{StaticResource T.Label}" Margin="0,0,0,7" />
                        <TextBox Style="{StaticResource Input}" Tag="f40fa49adab4f9a9"
                                 Text="{Binding ShortId, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="flow" Style="{StaticResource T.Label}" Margin="0,0,0,7" />
                        <TextBox Style="{StaticResource Input}" Tag="xtls-rprx-vision"
                                 Text="{Binding Flow, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===== WebSocket ===== -->
            <StackPanel x:Name="WsGroup">
                <TextBlock Text="{loc:T Editor_WsPath}" Style="{StaticResource T.Label}" Margin="0,14,0,7" />
                <TextBox Style="{StaticResource Input}" Tag="/ws"
                         Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- ===== логин ===== -->
            <StackPanel x:Name="UserGroup">
                <TextBlock Text="{loc:T Editor_Username}" Style="{StaticResource T.Label}" Margin="0,14,0,7" />
                <TextBox Style="{StaticResource Input}" Tag="user"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel x:Name="PasswordGroup">
                <TextBlock Text="{loc:T Editor_Password}" Style="{StaticResource T.Label}" Margin="0,14,0,7" />
                <TextBox Style="{StaticResource Input}" Tag="••••••••"
                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Style="{StaticResource T.Caption}"
                       Foreground="{StaticResource Danger}" Margin="0,14,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Grid Margin="0,22,0,0">
                <Button Content="{loc:T Common_Cancel}" Style="{StaticResource Btn.Ghost}"
                        HorizontalAlignment="Left" Click="OnCancel" />
                <Button Content="{loc:T Common_Save}" Style="{StaticResource Btn.Primary}"
                        HorizontalAlignment="Right" Click="OnSave" />
            </Grid>
        </StackPanel>
    </Border>
</Window>