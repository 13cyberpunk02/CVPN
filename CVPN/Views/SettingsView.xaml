<UserControl x:Class="CVPN.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CVPN.ViewModels"
             xmlns:loc="clr-namespace:CVPN.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:T Nav_Settings}" Style="{StaticResource T.Title}" />
            <TextBlock Text="{loc:T Settings_Subtitle}" Style="{StaticResource T.Secondary}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:T Settings_CorePath}" Style="{StaticResource T.Label}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource Input}"
                                     Text="{Binding Settings.CorePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="{loc:T Common_Browse}" Style="{StaticResource Btn.Base}"
                                    Margin="8,0,0,0" Command="{Binding BrowseCore}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_Tun}" Style="{StaticResource T.Body}" />
                                <TextBlock Text="{loc:T Settings_TunHint}"
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.TunEnabled}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_MixedPort}" Style="{StaticResource T.Body}" />
                                <TextBlock Text="{loc:T Settings_MixedPortHint}"
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBox Style="{StaticResource Input}"
                                     Text="{Binding Settings.MixedPort, UpdateSourceTrigger=PropertyChanged}"
                                     Width="96"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_KillSwitch}" Style="{StaticResource T.Body}" />
                                <TextBlock Text="{loc:T Settings_KillSwitchHint}"
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           MaxWidth="380" HorizontalAlignment="Left" />
                                <TextBlock Text="{loc:T Settings_KillSwitchWarning}"
                                           Style="{StaticResource T.Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                           MaxWidth="380" HorizontalAlignment="Left"
                                           Foreground="{StaticResource Warning}" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.KillSwitch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" />
                        </Grid>

                        <Button Content="{loc:T Settings_RestoreNetwork}" Style="{StaticResource Btn.Base}"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                ToolTip="{loc:T Settings_RestoreNetworkHint}"
                                Command="{Binding RestoreNetwork}" />

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_AutoSelect}" Style="{StaticResource T.Body}" />
                                <TextBlock Text="{loc:T Settings_AutoSelectHint}"
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           MaxWidth="380" HorizontalAlignment="Left" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}"
                                          IsChecked="{Binding Settings.AutoSelectFastest}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_VerboseLog}" Style="{StaticResource T.Body}" />
                                <TextBlock Text="{loc:T Settings_VerboseLogHint}"
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           MaxWidth="380" HorizontalAlignment="Left" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.VerboseLog}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_CloseToTray}" Style="{StaticResource T.Body}" />
                                <TextBlock Text="{loc:T Settings_CloseToTrayHint}"
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.CloseToTray}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_AutoStart}" Style="{StaticResource T.Body}" />
                                <TextBlock Text="{loc:T Settings_AutoStartHint}"
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.AutoStart}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_AutoConnect}" Style="{StaticResource T.Body}" />
                                <TextBlock Text="{loc:T Settings_AutoConnectHint}"
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.AutoConnect}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Settings_Language}" Style="{StaticResource T.Label}" />

                        <ComboBox Style="{StaticResource Select}" Margin="0,10,0,0"
                                  ItemsSource="{Binding Languages}"
                                  SelectedValue="{Binding Settings.Language, Mode=TwoWay}"
                                  SelectedValuePath="Code">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Body}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{loc:T Settings_LanguageHint}" Margin="0,8,0,0"
                                   Foreground="{StaticResource Warning}"
                                   Style="{StaticResource T.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Settings_Version}" Style="{StaticResource T.Label}" />

                        <Grid Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding UpdateLabel}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{loc:T Settings_CheckUpdates}" Style="{StaticResource T.Caption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.CheckUpdates}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_AutoSubscription}" Style="{StaticResource T.Body}" />
                                <TextBlock Text="{loc:T Settings_AutoSubscriptionHint}"
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}"
                                          IsChecked="{Binding Settings.AutoUpdateSubscription}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{loc:T Settings_CheckNow}" Style="{StaticResource Btn.Base}"
                                    Command="{Binding CheckUpdate}" />
                            <Button Content="{loc:T Settings_OpenRelease}"
                                    Margin="8,0,0,0" Command="{Binding OpenRelease}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Settings_Service}" Style="{StaticResource T.Label}" />
                        <TextBlock Text="{loc:T Settings_ServiceHint}"
                                   Style="{StaticResource T.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

                        <Grid Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_UseService}" Style="{StaticResource T.Body}" />
                                <TextBlock Text="{Binding ServiceStatus}" Style="{StaticResource T.Caption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.UseService}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{loc:T Settings_InstallService}" Style="{StaticResource Btn.Base}"
                                    Command="{Binding InstallService}" />
                            <Button Content="{loc:T Settings_UninstallService}" Style="{StaticResource Btn.Ghost}"
                                    Margin="8,0,0,0" Command="{Binding UninstallService}" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,16" />

                        <TextBlock Text="{loc:T Settings_Task}" Style="{StaticResource T.Label}" />
                        <TextBlock Text="{loc:T Settings_TaskHint}"
                                   Style="{StaticResource T.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TaskStatus}" Style="{StaticResource T.Caption}"
                                   Margin="0,6,0,0" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{loc:T Settings_CreateTask}" Style="{StaticResource Btn.Base}"
                                    Command="{Binding InstallTask}" />
                            <Button Content="{loc:T Settings_DeleteTask}" Style="{StaticResource Btn.Ghost}"
                                    Margin="8,0,0,0" Command="{Binding UninstallTask}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="dns" Style="{StaticResource T.Label}" />
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding Settings.RemoteDns, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,8,0,0" />
                        <TextBlock Text="{loc:T Settings_DnsHint}"
                                   Style="{StaticResource T.Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>