<UserControl x:Class="CVPN.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CVPN.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Настройки" Style="{StaticResource T.Title}" />
            <TextBlock Text="Ядро, режим перехвата трафика и запуск" Style="{StaticResource T.Secondary}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="путь к ядру" Style="{StaticResource T.Label}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource Input}"
                                     Text="{Binding Settings.CorePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Обзор" Style="{StaticResource Btn.Base}"
                                    Margin="8,0,0,0" Command="{Binding BrowseCore}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Режим TUN" Style="{StaticResource T.Body}" />
                                <TextBlock
                                    Text="Перехватывает весь системный трафик. Требует прав администратора - CVPN предложит перезапуск."
                                    Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.TunEnabled}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Смешанный порт" Style="{StaticResource T.Body}" />
                                <TextBlock Text="Когда TUN выключен, этот порт прописывается системным прокси Windows"
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBox Style="{StaticResource Input}"
                                     Text="{Binding Settings.MixedPort, UpdateSourceTrigger=PropertyChanged}"
                                     Width="96"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Запрещать трафик мимо туннеля" Style="{StaticResource T.Body}" />
                                <TextBlock
                                    Text="Kill switch: при обрыве соединения интернет не уйдёт в обход. Требует прав администратора."
                                    Style="{StaticResource T.Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                    MaxWidth="380" HorizontalAlignment="Left" />
                                <TextBlock
                                    Text="Если приложение завершится аварийно, правила снимутся при следующем запуске. Кнопка ниже - на случай, когда интернет нужен прямо сейчас."
                                    Style="{StaticResource T.Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                    MaxWidth="380" HorizontalAlignment="Left"
                                    Foreground="{StaticResource Warning}" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.KillSwitch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" />
                        </Grid>

                        <Button Content="Восстановить сеть" Style="{StaticResource Btn.Base}"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                ToolTip="Снимает правила брандмауэра, если интернет пропал вместе с туннелем"
                                Command="{Binding RestoreNetwork}" />

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Автовыбор быстрого сервера" Style="{StaticResource T.Body}" />
                                <TextBlock
                                    Text="Ядро само держит соединение на быстрейшем сервере и перепроверяет раз в три минуты."
                                    Style="{StaticResource T.Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                    MaxWidth="380" HorizontalAlignment="Left" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}"
                                          IsChecked="{Binding Settings.AutoSelectFastest}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Подробный лог" Style="{StaticResource T.Body}" />
                                <TextBlock
                                    Text="Ядро пишет, какое правило сработало для каждого соединения. Помогает понять, почему сайт идёт не туда."
                                    Style="{StaticResource T.Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                    MaxWidth="380" HorizontalAlignment="Left" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.VerboseLog}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Сворачивать в трей" Style="{StaticResource T.Body}" />
                                <TextBlock Text="Крестик прячет окно вместо выхода. Выйти можно из меню значка."
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.CloseToTray}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Запуск вместе с Windows" Style="{StaticResource T.Body}" />
                                <TextBlock Text="Приложение стартует свёрнутым в трей"
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.AutoStart}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Подключаться при запуске" Style="{StaticResource T.Body}" />
                                <TextBlock Text="Сразу поднимать туннель с последним выбранным профилем"
                                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.AutoConnect}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="версия" Style="{StaticResource T.Label}" />

                        <Grid Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding UpdateLabel}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Проверять при запуске" Style="{StaticResource T.Caption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.CheckUpdates}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Проверить сейчас" Style="{StaticResource Btn.Base}"
                                    Command="{Binding CheckUpdate}" />
                            <Button Content="Открыть страницу релиза"
                                    Margin="8,0,0,0" Command="{Binding OpenRelease}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="служба туннеля" Style="{StaticResource T.Label}" />
                        <TextBlock
                            Text="Служба работает под системной учётной записью и поднимает TUN без запроса прав администратора. Устанавливается один раз."
                            Style="{StaticResource T.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

                        <Grid Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Использовать службу" Style="{StaticResource T.Body}" />
                                <TextBlock Text="{Binding ServiceStatus}" Style="{StaticResource T.Caption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Settings.UseService}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Установить службу" Style="{StaticResource Btn.Base}"
                                    Command="{Binding InstallService}" />
                            <Button Content="Удалить службу" Style="{StaticResource Btn.Ghost}"
                                    Margin="8,0,0,0" Command="{Binding UninstallService}" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,16" />

                        <TextBlock Text="или задача планировщика" Style="{StaticResource T.Label}" />
                        <TextBlock
                            Text="Проще службы: отдельный проект не нужен. Приложение целиком запускается с правами администратора, а туннель живёт только внутри вашего сеанса."
                            Style="{StaticResource T.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TaskStatus}" Style="{StaticResource T.Caption}"
                                   Margin="0,6,0,0" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Создать задачу" Style="{StaticResource Btn.Base}"
                                    Command="{Binding InstallTask}" />
                            <Button Content="Удалить задачу" Style="{StaticResource Btn.Ghost}"
                                    Margin="8,0,0,0" Command="{Binding UninstallTask}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="dns" Style="{StaticResource T.Label}" />
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding Settings.RemoteDns, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,8,0,0" />
                        <TextBlock
                            Text="Запросы вне правил уходят на этот резолвер через туннель. Схема задаёт транспорт: https:// (DoH, по 443 - надёжнее всего), tls:// (DoT, порт 853 часто блокируется), quic://, udp://."
                            Style="{StaticResource T.Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>