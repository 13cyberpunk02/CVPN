<UserControl x:Class="CVPN.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CVPN.Controls"
             xmlns:enums="clr-namespace:CVPN.Models.Enums"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CVPN.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Строка состояния -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TextFaint}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static enums:TunnelState.Connected}">
                                    <Setter Property="Fill" Value="{StaticResource Connected}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static enums:TunnelState.Connecting}">
                                    <Setter Property="Fill" Value="{StaticResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static enums:TunnelState.Failing}">
                                    <Setter Property="Fill" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StateLabel}" Style="{StaticResource T.Mono}" Margin="9,0,0,0"
                           FontSize="{StaticResource Size.Caption}" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Замерить задержку" Style="{StaticResource Btn.Ghost}" Padding="8,3"
                        FontSize="{StaticResource Size.Caption}" Command="{Binding MeasureDelay}" />
                <TextBlock Text="{Binding Uptime}" Style="{StaticResource T.Mono}" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontSize="{StaticResource Size.Caption}" />
            </StackPanel>
        </Grid>

        <!-- Подпись интерфейса -->
        <c:ConnectDial Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                       State="{Binding State}"
                       Title="{Binding Active.Name, TargetNullValue=Профиль не выбран,
                                                    FallbackValue=Профиль не выбран}"
                       Subtitle="{Binding Active.ProtocolLabel, TargetNullValue=-, FallbackValue=-}"
                       Metric="{Binding Active.LatencyLabel, TargetNullValue=-, FallbackValue=-}"
                       Country="{Binding Active.CountryCode, TargetNullValue='', FallbackValue=''}"
                       Flag="{Binding Active.FlagImage}"
                       Endpoint="{Binding Active.Endpoint, TargetNullValue='', FallbackValue=''}"
                       ActionLabel="{Binding PrimaryActionLabel}"
                       Command="{Binding ToggleConnection}"
                       Activated="OnDialActivated" />

        <!-- Показатели -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,20,0,0">
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,5,0" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="приём" Style="{StaticResource T.Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Download}" Style="{StaticResource T.Mono}" FontSize="18"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding DownloadUnit}" Style="{StaticResource T.Caption}" Margin="6,0,0,2"
                                   VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,12" Margin="5,0" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="отдача" Style="{StaticResource T.Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Upload}" Style="{StaticResource T.Mono}" FontSize="18"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding UploadUnit}" Style="{StaticResource T.Caption}" Margin="6,0,0,2"
                                   VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,12" Margin="5,0,0,0" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="правила" Style="{StaticResource T.Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding ActiveRuleCount}" Style="{StaticResource T.Mono}" FontSize="18"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="активных" Style="{StaticResource T.Caption}" Margin="6,0,0,2"
                                   VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Итоги сессии остаются после отключения: их для того и собирали -->
        <Border Grid.Row="3" Padding="14,12" Margin="0,10,0,0" BorderThickness="0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Session.HasData}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <Grid>
                    <TextBlock Text="сессия" Style="{StaticResource T.Label}" />
                    <TextBlock Text="{Binding Session.Server}" Style="{StaticResource T.Caption}"
                               HorizontalAlignment="Right" />
                </Grid>

                <UniformGrid Columns="4" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Session.DurationLabel}" Style="{StaticResource T.Mono}"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="время" Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="{Binding Session.DownloadLabel}" Style="{StaticResource T.Mono}"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="принято" Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="{Binding Session.UploadLabel}" Style="{StaticResource T.Mono}"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="отдано" Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="{Binding Session.PeakLabel}" Style="{StaticResource T.Mono}"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="пик" Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Status}" Style="{StaticResource T.Caption}"
                   Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,10,0,0"
                   VerticalAlignment="Top" />

        <!-- Действие -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Проверить конфиг" Style="{StaticResource Btn.Base}"
                    HorizontalAlignment="Left" Command="{Binding CheckConfig}" />
            <Button Grid.Column="2" Content="Открыть config.json" Style="{StaticResource Btn.Ghost}"
                    Margin="6,0,0,0" Command="{Binding OpenConfig}" />
        </Grid>
    </Grid>

</UserControl>