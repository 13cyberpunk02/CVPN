<UserControl x:Class="CVPN.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:CVPN.Models"
             xmlns:vm="clr-namespace:CVPN.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionsViewModel, IsDesignTimeCreatable=False}">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Соединения" Style="{StaticResource T.Title}" />
                <TextBlock Text="Что куда идёт прямо сейчас и по какому правилу"
                           Style="{StaticResource T.Secondary}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource T.Caption}" Margin="0,6,0,0"
                           Foreground="{StaticResource Warning}" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource T.Mono}"
                       FontSize="{StaticResource Size.Caption}">
                <Run Text="{Binding Connections.Count, Mode=OneWay}" />
                <Run Text="активных" />
            </TextBlock>
        </Grid>

        <!-- Пустой список при отключённом туннеле - не ошибка, а нормальное состояние -->
        <TextBlock Grid.Row="1" Text="Соединений нет. Список заполняется, пока туннель поднят."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                   TextAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource T.Secondary}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Connections.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ListBox Grid.Row="1" Style="{StaticResource PlainList}" Margin="0,16,0,0"
                 ItemsSource="{Binding Connections}"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ConnectionInfo}">
                    <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource Radius}"
                            Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Цвет метки выхода - главное, что читается взглядом -->
                                    <Border CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Tint.Accent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirect}" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource Tint.Connected}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Outbound}" FontSize="{StaticResource Size.Caption}"
                                                   FontFamily="{StaticResource Font.Mono}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirect}" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource Connected}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <TextBlock Text="{Binding Endpoint}" Style="{StaticResource T.Mono}"
                                               Foreground="{StaticResource Text}" Margin="9,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding Rule}" Style="{StaticResource T.Caption}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                    <TextBlock Text="{Binding Process}" Style="{StaticResource T.Caption}"
                                               Foreground="{StaticResource TextFaint}" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding Network}" Style="{StaticResource T.Caption}"
                                               Foreground="{StaticResource TextFaint}" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock Text="{Binding TrafficLabel}" Style="{StaticResource T.Mono}"
                                           FontSize="{StaticResource Size.Caption}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding DurationLabel}" Style="{StaticResource T.Caption}"
                                           Foreground="{StaticResource TextFaint}" HorizontalAlignment="Right"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Внутри DataTemplate контекст - ConnectionInfo, поэтому
                                 до команд страницы добираемся через RelativeSource -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Напрямую" Style="{StaticResource Btn.Ghost}" Padding="9,5"
                                        ToolTip="Добавить правило: домен пойдёт мимо туннеля"
                                        Command="{Binding DataContext.RuleDirect,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Блок" Style="{StaticResource Btn.Ghost}" Padding="9,5"
                                        ToolTip="Добавить правило: домен блокируется"
                                        Command="{Binding DataContext.RuleBlock,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="✕" Style="{StaticResource Btn.Ghost}" Padding="9,5"
                                        ToolTip="Закрыть соединение"
                                        Command="{Binding DataContext.CloseConnection,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>