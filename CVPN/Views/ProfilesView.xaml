<UserControl x:Class="CVPN.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CVPN.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CVPN.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Профили" Style="{StaticResource T.Title}" />
                <TextBlock Text="Вставьте ссылку или импортируйте конфигурацию sing-box" Style="{StaticResource T.Secondary}"
                           Margin="0,4,0,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource T.Caption}" Margin="0,6,0,0"
                           Foreground="{StaticResource Warning}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Проверить все" Style="{StaticResource Btn.Ghost}"
                        Command="{Binding PingAll}" />
                <Button Content="Импорт из файла" Style="{StaticResource Btn.Base}"
                        Margin="8,0,0,0" Command="{Binding ImportFile}" />
                <Button Content="Создать вручную" Style="{StaticResource Btn.Primary}"
                        Margin="8,0,0,0" Command="{Binding CreateProfile}" />
            </StackPanel>
        </Grid>

        <!-- Импорт по ссылке: самый частый способ завести профиль, поэтому он вверху -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource Input}"
                     Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="vless://…  ·  anytls://…  ·  naive+https://…" />
            <Button Grid.Column="1" Content="Разобрать ссылку" Style="{StaticResource Btn.Base}"
                    Margin="8,0,0,0" Command="{Binding ImportLink}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource Input}"
                     Text="{Binding Settings.SubscriptionUrl, UpdateSourceTrigger=PropertyChanged}"
                     Tag="https://…  —  ссылка подписки" />
            <Button Grid.Column="1" Content="Обновить подписку" Style="{StaticResource Btn.Base}"
                    Margin="8,0,0,0" Command="{Binding UpdateSubscription}" />
        </Grid>

        <ListBox Grid.Row="3" Style="{StaticResource PlainList}" Margin="0,18,0,0"
                 ItemsSource="{Binding Profiles}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ServerProfile}">
                    <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusCard}"
                            BorderThickness="1" Padding="16,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="18" Height="12" VerticalAlignment="Center" Margin="0,0,9,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding FlagImage}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FlagImage}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Heading}" />
                                    <Border Background="{StaticResource Tint.Accent}" CornerRadius="4"
                                            Padding="6,2" Margin="10,1,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProtocolLabel}" Style="{StaticResource T.Mono}"
                                                   FontSize="{StaticResource Size.Caption}"
                                                   Foreground="{StaticResource Accent}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding Endpoint}" Style="{StaticResource T.Mono}"
                                               FontSize="{StaticResource Size.Small}" />
                                    <TextBlock Text="из подписки"
                                               Margin="10,0,0,0" Foreground="{StaticResource TextFaint}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.Caption}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Subscription}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding LatencyLabel}"
                                       VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
                                        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LatencyGrade}" Value="good">
                                                <Setter Property="Foreground" Value="{StaticResource Connected}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LatencyGrade}" Value="fair">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LatencyGrade}" Value="poor">
                                                <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LatencyGrade}" Value="dead">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Изменить" Style="{StaticResource Btn.Ghost}" Padding="10,6"
                                        Command="{Binding DataContext.EditProfileCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Удалить" Style="{StaticResource Btn.Ghost}" Padding="10,6"
                                        Command="{Binding DataContext.RemoveProfile,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Выбрать" Style="{StaticResource Btn.Base}" Padding="12,6"
                                        Margin="6,0,0,0"
                                        Command="{Binding DataContext.SelectProfile,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>