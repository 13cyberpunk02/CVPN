<UserControl x:Class="CVPN.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CVPN.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LogsViewModel, IsDesignTimeCreatable=False}">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Логи" Style="{StaticResource T.Title}" 
                           Margin="0, 0, 0, 7"/>
                <TextBlock Text="Живой вывод ядра. Полная история пишется в файл - кнопка «Папка логов»."
                           Style="{StaticResource T.Secondary}"
                           Margin="0,7,0,0" 
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource T.Caption}" Margin="0,6,0,0"
                           Foreground="{StaticResource Warning}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Папка логов" Style="{StaticResource Btn.Ghost}"
                        ToolTip="Файлы за последние 7 дней - их удобно приложить к сообщению об ошибке"
                        Command="{Binding OpenFolder}" />
                <Button Content="Копировать" Style="{StaticResource Btn.Base}" Margin="8,0,0,0"
                        Command="{Binding Copy}" />
                <Button Content="Очистить" Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0"
                        Command="{Binding Clear}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#FF090C11" CornerRadius="{StaticResource RadiusCard}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,18,0,0" Padding="14,12">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LogItems" ItemsSource="{Binding Log}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}"
                                       FontSize="{StaticResource Size.Small}" Margin="0,0,0,3"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>