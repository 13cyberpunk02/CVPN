<UserControl x:Class="CVPN.Controls.ConnectDial"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:CVPN.Models.Enums"
             xmlns:ctl="clr-namespace:CVPN.Controls"
             x:Name="Root" Width="240" Height="240">

    <UserControl.Resources>
        <!-- Ядро круга и есть кнопка: обод показывает состояние, центр им управляет -->
        <Style x:Key="DialCore" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Face" Width="152" Height="152"
                                     Fill="{StaticResource Surface}" />
                            <Ellipse x:Name="Edge" Width="152" Height="152"
                                     Stroke="{StaticResource Line}" StrokeThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Fill" Value="{StaticResource SurfaceRaised}" />
                                <Setter TargetName="Edge" Property="Stroke" Value="{StaticResource LineStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Fill" Value="{StaticResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Edge" Property="Stroke" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Внешний обод -->
        <Ellipse Width="210" Height="210" Stroke="{StaticResource Line}" StrokeThickness="1" />

        <!-- Тиковая шкала -->
        <Canvas Width="240" Height="240">
            <Canvas.Resources>
                <Style TargetType="Line">
                    <Setter Property="Stroke" Value="{StaticResource LineStrong}" />
                    <Setter Property="StrokeThickness" Value="1" />
                </Style>
            </Canvas.Resources>
            <Line X1="120" Y1="8" X2="120" Y2="16" />
            <Line X1="232" Y1="120" X2="224" Y2="120" />
            <Line X1="120" Y1="232" X2="120" Y2="224" />
            <Line X1="8" Y1="120" X2="16" Y2="120" />
            <Line X1="199.2" Y1="40.8" X2="193.5" Y2="46.5" />
            <Line X1="199.2" Y1="199.2" X2="193.5" Y2="193.5" />
            <Line X1="40.8" Y1="199.2" X2="46.5" Y2="193.5" />
            <Line X1="40.8" Y1="40.8" X2="46.5" Y2="46.5" />
        </Canvas>

        <!-- Дорожка -->
        <Ellipse Width="180" Height="180" Stroke="{StaticResource LineStrong}" StrokeThickness="6" />

        <!-- Дуга состояния -->
        <Ellipse Width="180" Height="180" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform Angle="-90" />
            </Ellipse.RenderTransform>
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="StrokeThickness" Value="6" />
                    <Setter Property="StrokeDashCap" Value="Round" />
                    <Setter Property="Stroke" Value="{StaticResource TextFaint}" />
                    <Setter Property="StrokeDashArray" Value="80 14" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}"
                                     Value="{x:Static enums:TunnelState.Connected}">
                            <Setter Property="Stroke" Value="{StaticResource Connected}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}"
                                     Value="{x:Static enums:TunnelState.Connecting}">
                            <Setter Property="Stroke" Value="{StaticResource Accent}" />
                            <Setter Property="StrokeDashArray" Value="18 76" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStory">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="-90" To="270" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinStory" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}"
                                     Value="{x:Static enums:TunnelState.Failing}">
                            <Setter Property="Stroke" Value="{StaticResource Danger}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>

        <!-- Кнопка -->
        <!-- Команда вызывается из code-behind: привязка через ElementName внутри
             контрола - лишняя точка отказа, а Click доходит всегда -->
        <Button Style="{StaticResource DialCore}" Width="152" Height="152"
                Background="Transparent" Click="OnCoreClick"
                ToolTip="{Binding Endpoint, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}">
            <StackPanel Width="130">

                <!-- Значок страны: буквенный, потому что Windows не рисует флаги-эмодзи -->
                <Border HorizontalAlignment="Center" CornerRadius="4" Padding="7,2"
                        Background="{StaticResource SurfaceHover}" Margin="0,0,0,7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Country, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <!-- Флаг картинкой: эмодзи-флаги Windows не отрисовывает -->
                        <Image Width="16" Height="11" VerticalAlignment="Center" Margin="0,0,6,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding Flag, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Flag, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding Country, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}"
                                   Style="{StaticResource T.Mono}" VerticalAlignment="Center"
                                   FontSize="{StaticResource Size.Caption}" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}" Style="{StaticResource T.Heading}"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}" Style="{StaticResource T.Mono}"
                           HorizontalAlignment="Center" Margin="0,3,0,0"
                           FontSize="{StaticResource Size.Caption}" TextTrimming="CharacterEllipsis" />

                <TextBlock Text="{Binding Metric, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}" HorizontalAlignment="Center" Margin="0,5,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}"
                                             Value="{x:Static enums:TunnelState.Connected}">
                                    <Setter Property="Foreground" Value="{StaticResource Connected}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}"
                                             Value="{x:Static enums:TunnelState.Failing}">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Height="1" Background="{StaticResource Line}" Margin="24,9,24,7" />

                <TextBlock Text="{Binding ActionLabel, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}" HorizontalAlignment="Center"
                           FontFamily="{StaticResource Font.Sans}" FontSize="{StaticResource Size.Body}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType={x:Type ctl:ConnectDial}}}"
                                             Value="{x:Static enums:TunnelState.Connected}">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
